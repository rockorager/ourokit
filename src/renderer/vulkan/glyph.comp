#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) buffer Target {
    uvec2 pixels[];
};

layout(set = 0, binding = 1, std430) readonly buffer Atlas {
    uint masks[];
};

layout(push_constant) uniform Push {
    uint target_width;
    uint atlas_width;
    uvec2 source;
    int left;
    int top;
    int right;
    int bottom;
    uint atlas_x;
    uint atlas_y;
    uint image_mode;
    uint image_rows;
    float image_left;
    float image_top;
    float image_width;
    float image_height;
};

#include "image.glsl"

uint channel16(uvec2 pixel, uint channel) {
    return channel < 2u ? ((pixel.x >> (channel * 16u)) & 65535u) : ((pixel.y >> ((channel - 2u) * 16u)) & 65535u);
}

uvec2 pack16(uvec4 value) {
    return uvec2(value.x | value.y << 16u, value.z | value.w << 16u);
}

uvec2 sourceOver(uvec2 source_value, uvec2 destination) {
    uint inverse_alpha = 65535u - channel16(source_value, 3u);
    uvec4 result;
    for (uint i = 0u; i < 4u; ++i) {
        result[i] = min(channel16(source_value, i) + (channel16(destination, i) * inverse_alpha + 32767u) / 65535u, 65535u);
    }
    return pack16(result);
}

void main() {
    uint width = uint(right - left);
    uint index = gl_GlobalInvocationID.x;
    uint count = width * uint(bottom - top);
    if (index >= count) return;

    uint x = index % width;
    uint y = index / width;
    uint target_index = uint(top + int(y)) * target_width + uint(left + int(x));
    if (image_mode == 1u) {
        uvec2 sampled = pack16(imageSampleLinear(vec2(left + int(x), top + int(y)) + vec2(0.5)));
        pixels[target_index] = sourceOver(sampled, pixels[target_index]);
        return;
    }
    if (image_mode == 2u) {
        uint offset = ((atlas_y + y) * atlas_width + atlas_x + x * 8u) / 4u;
        uvec2 sampled = uvec2(masks[offset], masks[offset + 1u]);
        uvec4 channels;
        for (uint i = 0u; i < 4u; ++i) {
            channels[i] = (channel16(sampled, i) * channel16(source, 3u) + 32767u) / 65535u;
        }
        pixels[target_index] = sourceOver(pack16(channels), pixels[target_index]);
        return;
    }
    uint atlas_index = (atlas_y + y) * atlas_width + atlas_x + x;
    uint coverage = (masks[atlas_index / 4u] >> ((atlas_index % 4u) * 8u)) & 255u;
    if (coverage == 0u) return;
    uvec4 covered_channels;
    for (uint i = 0u; i < 4u; ++i) {
        covered_channels[i] = (channel16(source, i) * (coverage * 257u) + 32767u) / 65535u;
    }
    uvec2 covered = pack16(covered_channels);
    pixels[target_index] = sourceOver(covered, pixels[target_index]);
}
