#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) buffer Target {
    uvec2 pixels[];
};

layout(push_constant) uniform Push {
    uint target_width;
    int left;
    int top;
    int right;
    int bottom;
    int shape_left;
    int shape_top;
    int shape_right;
    int shape_bottom;
    uvec2 background;
    uvec2 border;
    uint corner_radius;
    uint border_width;
    uint flags;
    uint source_over;
};

uint channel16(uvec2 pixel, uint channel) {
    return channel < 2u ? ((pixel.x >> (channel * 16u)) & 65535u) : ((pixel.y >> ((channel - 2u) * 16u)) & 65535u);
}

uvec2 pack16(uvec4 value) {
    return uvec2(value.x | value.y << 16u, value.z | value.w << 16u);
}

uvec2 sourceOver(uvec2 source, uvec2 destination) {
    uint inverse_alpha = 65535u - channel16(source, 3u);
    uvec4 result;
    for (uint i = 0u; i < 4u; ++i) {
        result[i] = min(channel16(source, i) + (channel16(destination, i) * inverse_alpha + 32767u) / 65535u, 65535u);
    }
    return pack16(result);
}

float roundedRectangleCoverage(vec2 point, vec4 bounds, float radius_value) {
    vec2 size = bounds.zw - bounds.xy;
    if (size.x <= 0.0 || size.y <= 0.0) return 0.0;
    float radius = min(radius_value, floor(min(size.x, size.y) * 0.5));
    if (radius == 0.0) return all(greaterThanEqual(point, bounds.xy)) && all(lessThan(point, bounds.zw)) ? 1.0 : 0.0;
    vec2 half_size = size * 0.5;
    vec2 delta = abs(point - (bounds.xy + bounds.zw) * 0.5) - (half_size - radius);
    float distance = length(max(delta, 0.0)) + min(max(delta.x, delta.y), 0.0) - radius;
    return clamp(0.5 - distance, 0.0, 1.0);
}

uvec2 scalePixel(uvec2 pixel, uint coverage) {
    uvec4 result;
    for (uint i = 0u; i < 4u; ++i) {
        result[i] = (channel16(pixel, i) * (coverage * 257u) + 32767u) / 65535u;
    }
    return pack16(result);
}

uvec2 addPixels(uvec2 a, uvec2 b) {
    uvec4 result;
    for (uint i = 0u; i < 4u; ++i) {
        result[i] = min(channel16(a, i) + channel16(b, i), 65535u);
    }
    return pack16(result);
}

void main() {
    uint width = uint(right - left);
    uint index = gl_GlobalInvocationID.x;
    uint count = width * uint(bottom - top);
    if (index >= count) return;

    uint x = uint(left) + index % width;
    uint y = uint(top) + index / width;
    vec2 point = vec2(x, y) + vec2(0.5);
    vec4 shape = vec4(shape_left, shape_top, shape_right, shape_bottom);
    uint outer_coverage = uint(roundedRectangleCoverage(point, shape, float(corner_radius)) * 255.0 + 0.5);
    if (outer_coverage == 0u) return;
    uint inset = min(border_width, uint(min(shape.z - shape.x, shape.w - shape.y)) / 2u);
    float inset_value = float(inset);
    vec4 inner = shape + vec4(inset_value, inset_value, -inset_value, -inset_value);
    uint inner_coverage = (flags & 2u) != 0u
        ? uint(roundedRectangleCoverage(point, inner, float(corner_radius > inset ? corner_radius - inset : 0u)) * 255.0 + 0.5)
        : 255u;
    uint border_coverage = (flags & 2u) != 0u
        ? (outer_coverage * (255u - inner_coverage) + 127u) / 255u
        : 0u;
    uint background_coverage = (flags & 1u) != 0u
        ? (outer_coverage * inner_coverage + 127u) / 255u
        : 0u;
    uint coverage = min(border_coverage + background_coverage, 255u);
    if (coverage == 0u) return;
    uvec2 source = addPixels(scalePixel(border, border_coverage), scalePixel(background, background_coverage));
    uint offset = y * target_width + x;
    if (source_over != 0u) {
        pixels[offset] = channel16(source, 3u) != 65535u ? sourceOver(source, pixels[offset]) : source;
    } else if (coverage == 255u) {
        pixels[offset] = source;
    } else {
        pixels[offset] = addPixels(source, scalePixel(pixels[offset], 255u - coverage));
    }
}
