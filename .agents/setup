#!/usr/bin/env bash
set -euo pipefail

# Native integration tests use an isolated compositor, not the orb's desktop.
# Portal fixtures run against a private D-Bus session through system Python.
# Application benchmarks also build the matched GTK and Qt software fixtures.
missing=()
for package in weston xvfb xdotool sway grim wtype libwayland-bin libwayland-dev gcc pkg-config wayland-utils python3-dbus python3-gi libgtk-4-dev qt6-base-dev qt6-wayland libcurl4-openssl-dev openssl ca-certificates; do
  if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != "install ok installed" ]]; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  sudo apt-get update -qq
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi

# The base development image supplies Zig and the native graphics dependencies.
# Image decoding also builds the pinned resvg bridge with Cargo.
if ! command -v cargo >/dev/null && [[ ! -x "$HOME/.cargo/bin/cargo" ]]; then
  installer="$(mktemp)"
  trap 'rm -f "$installer"' EXIT
  curl --fail --silent --show-error --location https://sh.rustup.rs -o "$installer"
  sh "$installer" -y --profile minimal --default-toolchain 1.94.0 --no-modify-path
fi

# ~/.local/bin is available to subsequent non-interactive orb login shells.
mkdir -p "$HOME/.local/bin"
for command in cargo rustc rustup; do
  if ! command -v "$command" >/dev/null && [[ -x "$HOME/.cargo/bin/$command" ]]; then
    if [[ ! -e "$HOME/.local/bin/$command" && ! -L "$HOME/.local/bin/$command" ]]; then
      ln -s "$HOME/.cargo/bin/$command" "$HOME/.local/bin/$command"
    fi
  fi
done
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
cargo --version
